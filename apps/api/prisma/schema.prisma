generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  ADMIN
  SUPERVISOR
  USER
}
enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum OrderStatus {
  PLACED
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}
enum PaymentMethod {
  COD
  WHATSAPP
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  name String
  passwordHash String
  role Role @default(USER)
  active Boolean @default(true)
  emailVerifiedAt DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile Profile?
  addresses Address[]
  sessions Session[]
  tokens VerificationToken[]
  permissions UserPermission[]
  products Product[]
  orders Order[]
  cart Cart?
  wishlist Wishlist?
  auditLogs AuditLog[]
  dashboardLayout DashboardLayout?
  @@index([role, createdAt])
}
model Profile {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  phone String?
  avatar String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Address {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  name String
  phone String
  line1 String
  line2 String @default("")
  city String
  state String
  pincode String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  familyId String @db.Uuid
  tokenHash String @unique
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip String?
  createdAt DateTime @default(now())
  @@index([userId, familyId])
  @@index([expiresAt])
}
model VerificationToken {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  purpose String
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, purpose])
}
model Permission {
  key String @id
  roles RolePermission[]
  overrides UserPermission[]
}
model RolePermission {
  role Role
  permission String
  definition Permission @relation(fields:[permission],references:[key],onDelete:Cascade)
  @@id([role,permission])
}
model UserPermission {
  userId String @db.Uuid
  permission String
  granted Boolean
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  definition Permission @relation(fields:[permission],references:[key],onDelete:Cascade)
  updatedAt DateTime @updatedAt
  @@id([userId,permission])
}
model Category {
  id String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique
  image String?
  parentId String? @db.Uuid
  parent Category? @relation("CategoryTree",fields:[parentId],references:[id],onDelete:Restrict)
  children Category[] @relation("CategoryTree")
  definitions AttributeDefinition[]
  products Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model AttributeDefinition {
  id String @id @default(uuid()) @db.Uuid
  categoryId String @db.Uuid
  category Category @relation(fields:[categoryId],references:[id],onDelete:Cascade)
  key String
  label String
  type String
  options String[]
  required Boolean @default(false)
  filterable Boolean @default(false)
  showOnCard Boolean @default(false)
  sortOrder Int @default(0)
  unit String?
  @@unique([categoryId,key])
}
model Product {
  id String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique
  description String
  categoryId String @db.Uuid
  category Category @relation(fields:[categoryId],references:[id],onDelete:Restrict)
  createdById String @db.Uuid
  createdBy User @relation(fields:[createdById],references:[id],onDelete:Restrict)
  price Int
  compareAtPrice Int?
  attributes Json @db.JsonB
  status ProductStatus @default(DRAFT)
  seoTitle String?
  seoDescription String?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  variants ProductVariant[]
  images ProductImage[]
  collections CollectionProduct[]
  wishlistItems WishlistItem[]
  @@index([categoryId,status,createdAt])
  @@index([status,createdAt])
  @@index([createdById])
  @@index([attributes],type:Gin)
}
model ProductVariant {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
  sku String @unique
  attributes Json @db.JsonB
  price Int?
  stock Int @default(0)
  active Boolean @default(true)
  images String[]
  cartItems CartItem[]
  orderItems OrderItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([productId])
}
model ProductImage {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  url String
  alt String
  sortOrder Int @default(0)
}
model Wishlist {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  items WishlistItem[]
}
model WishlistItem {
  wishlistId String @db.Uuid
  productId String @db.Uuid
  wishlist Wishlist @relation(fields:[wishlistId],references:[id],onDelete:Cascade)
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  @@id([wishlistId,productId])
}
model Cart {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  items CartItem[]
  updatedAt DateTime @updatedAt
}
model CartItem {
  cartId String @db.Uuid
  variantId String @db.Uuid
  quantity Int
  cart Cart @relation(fields:[cartId],references:[id],onDelete:Cascade)
  variant ProductVariant @relation(fields:[variantId],references:[id],onDelete:Cascade)
  @@id([cartId,variantId])
}
model Order {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  idempotencyKey String @unique @db.Uuid
  status OrderStatus @default(PLACED)
  paymentMethod PaymentMethod
  address Json @db.JsonB
  delivery String
  subtotal Int
  discount Int @default(0)
  shipping Int
  tax Int
  total Int
  couponCode String?
  whatsappSentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items OrderItem[]
  history OrderStatusHistory[]
  @@index([userId,createdAt])
  @@index([status,createdAt])
  @@index([createdAt,paymentMethod])
}
model OrderItem {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  variantId String @db.Uuid
  variant ProductVariant @relation(fields:[variantId],references:[id],onDelete:Restrict)
  name String
  sku String
  attributes Json
  price Int
  quantity Int
  image String?
  supervisorId String @db.Uuid
  categoryName String
}
model OrderStatusHistory {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  status OrderStatus
  actorId String @db.Uuid
  note String?
  createdAt DateTime @default(now())
}
model Banner {
  id String @id @default(uuid()) @db.Uuid
  title String
  subtitle String
  image String
  href String
  active Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Offer {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  title String
  percent Int
  minimum Int @default(0)
  startsAt DateTime @default(now())
  endsAt DateTime
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Collection {
  id String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique
  products CollectionProduct[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model CollectionProduct {
  collectionId String @db.Uuid
  productId String @db.Uuid
  collection Collection @relation(fields:[collectionId],references:[id],onDelete:Cascade)
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  @@id([collectionId,productId])
}
model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid
  actor User @relation(fields:[actorId],references:[id],onDelete:Restrict)
  action String
  resource String
  resourceId String
  ip String?
  before Json?
  after Json?
  createdAt DateTime @default(now())
  @@index([actorId,createdAt])
  @@index([resource,resourceId,createdAt])
}
model DashboardLayout {
  userId String @id @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  layout Json
  updatedAt DateTime @updatedAt
}
model Settings {
  id String @id @default("store")
  brandName String @default("AUREL")
  whatsappNumber String @default("")
  shipping Int @default(9900)
  expressShipping Int @default(19900)
  freeShippingThreshold Int @default(249900)
  taxBps Int @default(0)
  seoDescription String @default("Considered essentials. Made for your everyday.")
  maintenance Boolean @default(false)
  updatedAt DateTime @updatedAt
}
model DailySales {
  day DateTime @id @db.Date
  revenue BigInt
  orders Int
  updatedAt DateTime @updatedAt
}
model NewsletterSubscription {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  tokenHash String @unique
  expiresAt DateTime
  confirmedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Testimonial {
  id String @id @default(uuid()) @db.Uuid
  name String
  quote String
  location String
  rating Int
  active Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
